{
  "name": "ai-game-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal, deterministic hybrid web-game starter",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.{ts,js,mjs,cjs,mts,cts}\"",
    "test:examples": "npm run typecheck:examples && node --test examples/testing/*.test.ts",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test:browser": "playwright test",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "check:no-actions": "node scripts/check-no-actions.mjs",
    "check": "npm run check:no-actions && npm run lint:architecture && npm test && npm run build",
    "check:template": "npm run check && ./scripts/validate-template.sh"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "get-tsconfig": "4.14.3",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "packageManager": "npm@12.2.2"
}
